        - !<MatrixTransform> {matrix: [3.2096, -1.55743, -0.495805, 0, -0.970989, 1.88517, 0.0394894, 0, 0.0597193, -0.210104, 1.14312, 0, 0, 0, 0, 1]}
        - !<FileTransform> {src: linear_to_sRGB.spi1d, interpolation: linear}

  - !<ColorSpace>
    name: Utility - Gamma 2.2 - Rec. 709 - Texture
    family: Utility
    equalitygroup: Gamma 2.2 - Rec. 709 - Texture
    bitdepth: 32f
    description: |
      The Gamma 2.2 - Rec. 709 color space for importing certain textures.
    isdata: false
    allocation: uniform
    allocationvars: [0, 1]
    from_reference: !<GroupTransform>
